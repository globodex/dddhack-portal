# Node development rehearsal only; production compilation excludes this adapter.
PORTAL_LOCAL_TEST=1
PORTAL_LOCAL_DB=.local/portal.sqlite
# Hosted Worker runtime values are configured through Sites, never this file.
# Enable trust ONLY after confirming Sites Dispatch is the sole trusted ingress.
# PORTAL_RUNTIME=sites
# PORTAL_TRUST_SITES_DISPATCH=true
# CREDIT_ENCRYPTION_KEY=<fresh random 32-byte key, base64; Sites secret>
# DB is a logical D1 binding in .openai/hosting.json, not an environment URL.
# No API keys are required; external evaluation remains disabled.
