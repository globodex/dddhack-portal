# Vercel: server-only. Browser uses relative /api/*.
APP_ORIGIN=http://localhost:3000
NEON_API_ORIGIN=http://127.0.0.1:8788
PORTAL_PROXY_SECRET=
# Synthetic local development only, never production
# PORTAL_LOCAL_TEST=1
# PORTAL_LOCAL_DB=.local/portal.sqlite
# Neon backend user-managed values (secure configuration later)
AUTH_BASE_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CREDIT_ENCRYPTION_KEY=
NEON_MEDIA_BUCKET=project-media
JOB_RUNNER_SECRET=
# Automatically injected by Neon for enabled services, local pull only:
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# NEON_BRANCH=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=
