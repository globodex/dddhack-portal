# Local only: fake accounts and SQLite, never enables hosted authentication.
PORTAL_LOCAL_TEST=1
PORTAL_LOCAL_DB=.local/portal.sqlite
# Future Sites runtime must supply DB and these non-secret confirmations.
# PORTAL_RUNTIME=sites
# PORTAL_TRUST_SITES_DISPATCH=true
# CREDIT_ENCRYPTION_KEY=<32-byte random key, base64; configure through Sites secrets>
# No API keys are required; external evaluation is disabled in v1.
