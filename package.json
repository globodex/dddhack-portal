{
  "name": "devday-exchange-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:local": "tsx scripts/local-db.ts",
    "test:load": "tsx scripts/load.ts",
    "test:production": "node --import tsx scripts/production-smoke.mjs",
    "format": "prettier --write app lib scripts tests docs README.md",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "db:generate": "drizzle-kit generate",
    "dev:legacy": "node scripts/run-framework.mjs dev",
    "build:legacy": "node scripts/run-framework.mjs build && node scripts/review-production-artifact.mjs",
    "test:artifact:legacy": "node scripts/review-production-artifact.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@neon/config": "1.9.3",
    "drizzle-orm": "0.45.2",
    "jose": "6.2.13",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "raw-body": "3.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "1.42.0",
    "@cloudflare/workers-types": "4.20260617.1",
    "@electric-sql/pglite": "0.5.11",
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "acorn": "8.19.0",
    "drizzle-kit": "0.31.10",
    "es-module-lexer": "3.0.4",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "playwright-core": "1.56.1",
    "prettier": "3.9.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vinext": "1.3.0",
    "vite": "8.3.5",
    "wrangler": "4.102.0"
  },
  "overrides": {
    "fflate": "0.8.3",
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.29.1",
      "ws": "8.22.0"
    },
    "@cloudflare/vite-plugin": {
      "ws": "8.22.0"
    }
  }
}
