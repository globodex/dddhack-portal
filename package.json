{
  "name": "devday-exchange-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:local": "tsx scripts/local-db.ts",
    "test:load": "tsx scripts/load.ts",
    "test:production": "node --import tsx scripts/production-smoke.mjs",
    "format": "prettier --write app lib scripts tests docs README.md",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.3.0",
    "zod": "4.1.12",
    "drizzle-orm": "0.45.2",
    "raw-body": "3.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "4.20260515.1",
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "miniflare": "4.20260730.0",
    "prettier": "3.9.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "@cloudflare/vite-plugin": "1.37.1",
    "wrangler": "4.92.0",
    "drizzle-kit": "0.31.10",
    "playwright-core": "1.56.1"
  },
  "overrides": {
    "fflate": "0.8.3",
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.29.1",
      "ws": "8.22.0"
    },
    "@cloudflare/vite-plugin": {
      "ws": "8.22.0"
    }
  }
}
