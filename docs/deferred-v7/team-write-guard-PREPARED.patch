diff --git a/scripts/team-write-reset-guard.mjs b/scripts/team-write-reset-guard.mjs
new file mode 100644
index 0000000..fbebdeb
--- /dev/null
+++ b/scripts/team-write-reset-guard.mjs
@@ -0,0 +1,31 @@
+import assert from "node:assert/strict";
+export function assertTeamWriteReset({
+  manifest,
+  path,
+  token,
+  source,
+  worker,
+  artifactRoot,
+}) {
+  assert.match(
+    token || "",
+    /^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/,
+    "fresh manifest UUID reset token required",
+  );
+  assert.equal(
+    path,
+    "/tmp/ddehack-controls-" + token + ".json",
+    "exact coordinator reset receipt path required",
+  );
+  assert.equal(manifest.resetToken, token, "reset receipt token mismatch");
+  for (const key of ["disposable", "syntheticOnly", "rootConfirmedReset"])
+    assert.equal(manifest[key], true, "reset receipt must confirm " + key);
+  assert.equal(manifest.origin, "http://127.0.0.1:4173");
+  assert.equal(manifest.source, source, "stale reset receipt source");
+  assert.equal(manifest.worker, worker, "stale reset receipt Worker");
+  assert.equal(
+    manifest.artifactRoot,
+    artifactRoot,
+    "reset receipt artifact root mismatch",
+  );
+}
diff --git a/tests/team-write-reset-guard.test.ts b/tests/team-write-reset-guard.test.ts
new file mode 100644
index 0000000..f9725f7
--- /dev/null
+++ b/tests/team-write-reset-guard.test.ts
@@ -0,0 +1,47 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { assertTeamWriteReset } from "../scripts/team-write-reset-guard.mjs";
+const token = "eb825a68-849c-44db-9d27-581568de6c3a",
+  source = "a".repeat(40),
+  worker = "b".repeat(64),
+  artifactRoot = "/local/integration";
+const fixture = () => ({
+  path: "/tmp/ddehack-controls-" + token + ".json",
+  token,
+  source,
+  worker,
+  artifactRoot,
+  manifest: {
+    resetToken: token,
+    source,
+    worker,
+    artifactRoot,
+    origin: "http://127.0.0.1:4173",
+    disposable: true,
+    syntheticOnly: true,
+    rootConfirmedReset: true,
+  },
+});
+test("Team write reset accepts only matching explicit local reset evidence", () => {
+  assert.doesNotThrow(() => assertTeamWriteReset(fixture()));
+  for (const change of [
+    { source: "c".repeat(40) },
+    { worker: "d".repeat(64) },
+    { artifactRoot: "/other" },
+    { origin: "https://example.test" },
+    { resetToken: "fb825a68-849c-44db-9d27-581568de6c3a" },
+    { disposable: false },
+    { syntheticOnly: false },
+    { rootConfirmedReset: false },
+  ]) {
+    const f = fixture();
+    f.manifest = { ...f.manifest, ...change };
+    assert.throws(() => assertTeamWriteReset(f));
+  }
+  assert.throws(() =>
+    assertTeamWriteReset({ ...fixture(), path: "/tmp/other.json" }),
+  );
+  assert.throws(() =>
+    assertTeamWriteReset({ ...fixture(), token: token.replaceAll("-", "") }),
+  );
+});
